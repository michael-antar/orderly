# Copy to inventory.ini (gitignored), then replace the address and LAN CIDR.
[orderly]
orderly-1 ansible_host=192.168.1.50 ansible_user=ops ansible_ssh_private_key_file=~/.ssh/id_ed25519

[orderly:vars]
ansible_python_interpreter=/usr/bin/python3
lan_cidr=192.168.1.0/24
ssh_public_key_path=~/.ssh/id_ed25519.pub
